# 复制为 `.dev.vars` 用于本地 `npx wrangler pages dev`（切勿提交 .dev.vars）。
# 同样的值填到 Cloudflare 后台 → Workers & Pages → minova-titanv → Settings → Environment variables。

# --- Turnstile 防垃圾（Cloudflare → Turnstile → 你的站点 → Secret key）---
TURNSTILE_SECRET_KEY=

# --- CORS 允许的前端来源（你的站点地址）---
ALLOWED_ORIGIN=https://minova.dhow.ink

# --- 飞书 CRM（多维表格）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# --- 飞书群自定义机器人通知（可选）---
FEISHU_BOT_WEBHOOK_URL=
